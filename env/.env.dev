# This file includes environment variables that will be committed to git by default.

# Built-in environment variables
TEAMSFX_ENV=dev
TEAMSFX_API_USERNAME="app_db",
TEAMSFX_API_PASSWORD="postgres",
TEAMSFX_API_ENDPOINT="http://localhost:3000"
APP_NAME_SUFFIX=dev
API_BASE_URL="http://localhost:3000"


# Updating AZURE_SUBSCRIPTION_ID or AZURE_RESOURCE_GROUP_NAME after provision may also require an update to RESOURCE_SUFFIX, because some services require a globally unique name across subscriptions/resource groups.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP_NAME=
RESOURCE_SUFFIX=

TEAMS_APP_ID=
TEAMS_APP_TENANT_ID=
BOT_AZURE_APP_SERVICE_RESOURCE_ID=
BOT_DOMAIN=
BOT_ID=
BOT_TENANT_ID=

SHOP_API_BASE_URL=https://app:3000
SHOP_API_PRODUCTS_PATH=/products
SHOP_API_PRODUCT_DETAIL_PATH=/products/:id


# Use one of these when your API requires auth.
SHOP_API_TOKEN=
SHOP_API_KEY=
SHOP_API_KEY_HEADER=x-api-key
