SHOP_API_BASE_URL=https://localhost:3000
SHOP_API_PRODUCTS_PATH=/products
SHOP_API_PRODUCT_DETAIL_PATH=/products/:id

# Product responses should match your Prisma Product shape:
# { id, name, description, productVariants: [{ id, category, name, description }] }

# Use one of these when your API requires auth.
SHOP_API_TOKEN=
SHOP_API_KEY=
SHOP_API_KEY_HEADER=x-api-key
